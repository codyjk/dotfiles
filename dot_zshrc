# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Every file is optional: chezmoi only installs the modules you picked.
for f in ~/.path ~/.exports ~/.aliases ~/.git_aliases ~/.config/zsh/secrets.zsh; do
  [[ -r $f ]] && source $f
done

autoload -Uz compinit && compinit

(( $+commands[fzf] )) && source <(fzf --zsh)
(( $+commands[fnm] )) && eval "$(fnm env --use-on-cd --shell zsh)"

if [[ -r ~/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source ~/powerlevel10k/powerlevel10k.zsh-theme
  [[ -r ~/.p10k.zsh ]] && source ~/.p10k.zsh
fi

# Use emacs-style key bindings, which gives cursor control similar to bash.
bindkey -e
